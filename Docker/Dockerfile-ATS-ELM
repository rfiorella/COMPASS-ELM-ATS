# adds E3SM to container with ATS already compiled,
# provides backbone for e3sm testing

FROM metsi/ats:elm_ats-arm64-latest
#FROM metsi/ats:latest


ARG https_proxy=
ARG http_proxy=

# Set path to make it easier to run amanzi
ENV PATH=/home/amanzi_user/install/bin:${PATH}
RUN echo $PATH
USER root

# Add cime directory
RUN mkdir /home/amanzi_user/.cime \
    && mkdir /.cime/

# Unset proxy
ENV https_proxy= \
    http_proxy=

# Copy some things into container
# NOW E3SM mounted as a volume from submodule on CI (and from local copy locally)
COPY --chown="amanzi_user:amanzi_user" cime_files/* /home/amanzi_user/.cime/
COPY cime_files/* /.cime/
ADD --chown="amanzi_user:amanzi_user" scripts/ /home/amanzi_user/scripts

# add libxml, perl interface for CIME
RUN apt-get -q update -y && apt-get install -y \
    libxml2 \
    libxml2-dev \
    libxml2-utils \
    libxml-libxml-perl \
    subversion \
    csh \
    && apt-get clean all \
    && mv /bin/sh /bin/sh.orig \
    && ln -s /bin/bash /bin/sh \
    # need to make each of these directories explicitly because RUN uses
    # /bin/sh and so brace expansion is not available:
    && cd /home/amanzi_user \
    && mkdir -p work/cases \
    && mkdir -p work/output \
    && chown -R amanzi_user:amanzi_user work

#USER amanzi_user
ENV USER=amanzi_user \
    CIMEROOT=home/amanzi_user/E3SM/cime \
    PYTHONPATH=/home/amanzi_user/E3SM/cime/scripts/Tools:/home/amanzi_user/E3SM/cime/scripts/lib \
    CIME_MODEL=e3sm \
    ATS_DIR=/home/amanzi_user/install/ \
    NETCDF_PATH=/home/amanzi_user/install/tpls \
    HDF5_HOME=/home/amanzi_user/install/tpls \
    HDF5_PATH=/home/amanzi_user/install/tpls 

WORKDIR /home/amanzi_user

RUN cd /home/amanzi_user/install/lib \
    && sed -i -e '4a\if (NOT TARGET netcdf)' -e '11i\endif()' AmanziImportedTargets.cmake \
    && git config --global user.email "elmats@dev.null" \
    && git config --global user.name "ELM-ATS Developer"
